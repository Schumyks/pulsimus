# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# local tooling artifacts
.playwright-cli/

# design reference (Fable v1 export, extracted to docs/f3-intro-donante.md)
Pulsimus Landing.html

# typescript
*.tsbuildinfo
next-env.d.ts

# session handoffs (never committed)
Handoffs/

# claude local state
.claude/settings.local.json
.claude/worktrees/

# Cloud source plates (Higgsfield originals, 3168px, ~43MB) — pipeline INPUT
# only. The site ships public/clouds/processed/ (WebP). Keep the raw plates
# local as source; do not bloat the repo history with them.
/public/clouds/*.png

# Space asset source plates (Higgsfield originals) — pipeline INPUT only.
# The site ships processed WebP under public/space/.
/space-src/
